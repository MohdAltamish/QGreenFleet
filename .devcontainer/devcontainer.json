{
  "name": "QGreenFleet",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "RUN.md"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo xargs apt install -y <packages.txt; pip3 install --user -r requirements.txt && cd frontend && npm ci",
  "postAttachCommand": { "server": "make dev PYTHON=python3" },
  "portsAttributes": {
    "5173": { "label": "Dashboard", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [5173, 8000]
}
