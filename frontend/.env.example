# Origin of the QGreenFleet FastAPI backend that `npm run dev` proxies /api to.
VITE_API_TARGET=http://127.0.0.1:8000

# Set only for a production build served from a different origin than the API.
# Leave unset to call /api on the same origin the app is served from.
# VITE_API_BASE=https://qgreenfleet.example.com
